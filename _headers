# Cloudflare Pages — https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

/
  Cache-Control: no-cache

/*.html
  Cache-Control: no-cache

/CLAUDE.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: no-cache

/ROADMAP.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/tokens/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/uploads/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
